{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/software-factory/feature-manifest.schema.json",
  "title": "Software Factory Work Package Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "work_package_id",
    "prd_id",
    "title",
    "contract_revision",
    "outcome_contract",
    "build_contract",
    "risk",
    "independence",
    "acceptance_criteria",
    "allowed_paths",
    "forbidden_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "work_package_id": {
      "type": "string",
      "pattern": "^WP-[A-Z0-9-]+-[0-9]{3}$"
    },
    "prd_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome_contract": {
      "type": "string"
    },
    "build_contract": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "independence": {
      "enum": [
        "I0",
        "I1",
        "I2",
        "I3"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
